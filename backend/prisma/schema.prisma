// Prisma schema para o MVP de Gestão de Obras
// Compatível com PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String?  @unique
  telefone     String   @unique
  senhaHash    String   @map("senha_hash")
  perfil       String   // 'gestor' | 'estagiario' | 'operario'
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  obrasResponsavel     Obra[]               @relation("ObraResponsavel")
  compromissosCriados  CompromissoSemanal[] @relation("CompromissoCriador")
  tarefasCriadas       Tarefa[]             @relation("TarefaCriador")
  evolucoesRegistradas EvolucaoTarefa[]     @relation("EvolucaoUsuario")
  localizacoes         LocalizacaoPeriodica[]
  rdosCriados          Rdo[]                @relation("RdoCriador")

  @@map("usuarios")
}

model Obra {
  id             Int      @id @default(autoincrement())
  nome           String
  endereco       String?
  cidade         String?
  estado         String?
  clienteNome    String?  @map("cliente_nome")
  clienteContato String?  @map("cliente_contato")
  responsavelId  Int?     @map("responsavel_id")
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @default(now()) @updatedAt @map("atualizado_em")

  responsavel   Usuario?            @relation("ObraResponsavel", fields: [responsavelId], references: [id])
  frentes       Frente[]
  equipes       Equipe[]
  colaboradores Colaborador[]
  compromissos  CompromissoSemanal[]
  tarefas       Tarefa[]
  rdos          Rdo[]

  @@map("obras")
}

model Frente {
  id        Int      @id @default(autoincrement())
  obraId    Int      @map("obra_id")
  nome      String
  nivel     Int      @default(0)
  descricao String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  obra         Obra                 @relation(fields: [obraId], references: [id])
  compromissos CompromissoSemanal[]
  tarefas      Tarefa[]
  rdosItens    RdoItem[]

  @@map("frentes")
}

model Servico {
  id                      Int      @id @default(autoincrement())
  nome                    String   @unique
  unidade                 String   // m2, m3, m, un, %
  produtividadeReferencia Decimal? @map("produtividade_referencia")
  descricao               String?
  ativo                   Boolean  @default(true)
